{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monark.local/schemas/policy-row.schema.json",
  "title": "PolicyTable",
  "description": "A policy table file of row format class-policy-v2 (contract 1.1.0, spec section 10): one ClassEntry and its PolicyRow list. This schema states what holds for one key alone: type, nullability, enumeration, pattern and integer bounds. Every key is required; null is written, never omitted. Valid against this schema does not mean admitted: the server also holds rules this file does not state, among them the shortest round-trip writing of a decimal string (so -0 and 0.10000000000000001 match the decimal pattern and are refused), strictly increasing strata_cuts, scale_table.sha256 equal to the canonical digest of scale_table.values, the couplings between columns (vetoes with test, bridge and fwd; retire exactly on a retired row; a tail numerator with its denominator; side leading bucket; miss_bound and bound_on on a region row only; the sign-set columns; the closed column list of a marginal row, which sets p_served, qhat and marginal_alpha), the file rules (sorted rows, one key per row, one current row, task_class of the class) and the canonical writing (no lone surrogate).",
  "type": "object", "additionalProperties": false,
  "required": ["row_format", "class", "rows"],
  "properties": { "row_format": { "const": "class-policy-v2" }, "class": { "$ref": "#/$defs/ClassEntry" }, "rows": { "type": "array", "items": { "$ref": "#/$defs/PolicyRow" } } },
  "$defs": {
    "Hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "Dec": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?(e[+-][1-9][0-9]*)?$", "description": "Superset of the shortest round-trip writing of a finite double (Number::toString); the server refuses any other writing." },
    "UTest": { "type": "string", "pattern": "^(1|0\\.[0-9]{7})$" },
    "VetoBlock": { "type": "object", "additionalProperties": false, "required": ["k_test", "n_test", "u_test"], "properties": { "k_test": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 }, "n_test": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "u_test": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/UTest" }] } } },
    "ClassEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["task_class", "region_kind", "region_rule", "qhat_unit", "statement", "method", "alpha", "test_delta", "n_min", "h_ms", "grid", "cell_key_rule", "cell_key_base", "strata_cuts", "label_schema", "text"],
      "properties": {
        "task_class": { "type": "string" },
        "region_kind": { "enum": ["set", "interval"] },
        "region_rule": { "enum": ["sign-set", "scaled-band", "additive-band", "upper-bound"] },
        "qhat_unit": { "enum": ["label", "scale", "score"] },
        "statement": { "enum": ["per-calibration", "marginal"] },
        "method": { "enum": ["risk-control", "split"] },
        "alpha": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Dec" }] },
        "test_delta": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Dec" }] },
        "n_min": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 },
        "h_ms": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 },
        "grid": { "type": "boolean" },
        "cell_key_rule": { "enum": ["kata-bucket", "committed-key", "liq-stratum"] },
        "cell_key_base": { "type": ["string", "null"] },
        "strata_cuts": { "type": ["array", "null"], "items": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "description": "Strictly increasing (held by the server)." },
        "label_schema": { "type": ["string", "null"] },
        "text": { "type": "string" }
      }
    },
    "PolicyRow": {
      "type": "object", "additionalProperties": false,
      "required": ["row_format", "task_class", "cell_key", "region_rule", "current", "kata_id", "w", "venue", "symbol", "horizon", "side", "bucket", "thresholds", "scale_table", "calib_support", "fit_sha256", "statement", "alpha", "test_delta", "calib_attempt", "calib_cause", "calib_parent", "epoch", "bound_on", "tau_cap", "n_min", "n", "k_star", "p_served", "k_obs", "misses", "qhat", "miss_bound", "marginal_alpha", "aux_seq", "runs_miss", "runs_aux", "tail_frac", "runs_level", "tail_m", "tail_a", "tail_tail_num", "tail_tail_den", "miss_adj_a", "miss_adj_tail_num", "miss_adj_tail_den", "test", "bridge", "fwd", "vetoes", "status", "status_reason", "retire", "scores_sha256", "aux_sha256", "series_sha256", "order", "source", "recompute", "text"],
      "properties": {
        "row_format": { "const": "class-policy-v2" },
        "task_class": { "type": "string" },
        "cell_key": { "type": "string" },
        "region_rule": { "enum": ["sign-set", "scaled-band", "additive-band", "upper-bound"] },
        "current": { "type": "boolean" },
        "kata_id": { "type": ["string", "null"] },
        "w": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 },
        "venue": { "type": ["string", "null"] },
        "symbol": { "type": ["string", "null"] },
        "horizon": { "enum": ["15m", "1h", "4h", "24h", null] },
        "side": { "enum": ["up", "down", null] },
        "bucket": { "enum": ["up-b1", "up-b2", "up-b3", "down-b1", "down-b2", "down-b3", "b0", null] },
        "thresholds": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["t1", "t2"], "properties": { "t1": { "$ref": "#/$defs/Dec" }, "t2": { "$ref": "#/$defs/Dec" } } }] },
        "scale_table": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["kind", "values", "sha256"], "properties": { "kind": { "enum": ["hour-of-week", "us-profile"] }, "values": { "type": "array", "items": { "type": ["number", "null"], "exclusiveMinimum": 0 } }, "sha256": { "$ref": "#/$defs/Hex64" } } }] },
        "calib_support": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": { "min": { "type": "number", "exclusiveMinimum": 0 }, "max": { "type": "number", "exclusiveMinimum": 0 } } }] },
        "fit_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Hex64" }] },
        "statement": { "enum": ["per-calibration", "marginal"] },
        "alpha": { "type": "string", "pattern": "^0\\.[0-9]{0,3}[1-9]$" },
        "test_delta": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Dec" }] },
        "calib_attempt": { "type": "integer", "minimum": 1, "maximum": 4 },
        "calib_cause": { "type": ["string", "null"] },
        "calib_parent": { "type": ["string", "null"], "pattern": "^(none|[0-9a-f]{64})$" },
        "epoch": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 },
        "bound_on": { "enum": ["commit", "region", null] },
        "tau_cap": { "enum": [1, null] },
        "n_min": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "n": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "k_star": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "p_served": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 },
        "k_obs": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "misses": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "qhat": { "type": ["number", "null"] },
        "miss_bound": { "type": ["string", "null"], "pattern": "^0\\.[0-9]{7}$" },
        "marginal_alpha": { "type": ["string", "null"], "pattern": "^0\\.[0-9]{4}$" },
        "aux_seq": { "enum": ["label", "score", null] },
        "runs_miss": { "enum": ["pass", "reject", "empty", null] },
        "runs_aux": { "enum": ["pass", "reject", "empty", null] },
        "tail_frac": { "type": ["string", "null"] },
        "runs_level": { "type": ["string", "null"] },
        "tail_m": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "tail_a": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "tail_tail_num": { "type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)$" },
        "tail_tail_den": { "type": ["string", "null"], "pattern": "^[1-9][0-9]*$" },
        "miss_adj_a": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "miss_adj_tail_num": { "type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)$" },
        "miss_adj_tail_den": { "type": ["string", "null"], "pattern": "^[1-9][0-9]*$" },
        "test": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/VetoBlock" }] },
        "bridge": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/VetoBlock" }] },
        "fwd": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/VetoBlock" }] },
        "vetoes": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["test", "bridge", "fwd"], "properties": { "test": { "type": "boolean" }, "bridge": { "type": ["boolean", "null"] }, "fwd": { "type": ["boolean", "null"] } } }] },
        "status": { "enum": ["region", "silence", "vetoed", "under_calib", "retired"] },
        "status_reason": { "type": "string" },
        "retire": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["cause", "k_test", "n_test", "u_test"], "properties": { "cause": { "type": "string" }, "k_test": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 }, "n_test": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 }, "u_test": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/UTest" }] } } }] },
        "scores_sha256": { "$ref": "#/$defs/Hex64" },
        "aux_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Hex64" }] },
        "series_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Hex64" }] },
        "order": { "enum": ["time", "ascending"] },
        "source": { "type": "object", "additionalProperties": false, "required": ["registry_file", "registry_sha256", "trial_id", "wave", "generator"], "properties": { "registry_file": { "type": "string" }, "registry_sha256": { "$ref": "#/$defs/Hex64" }, "trial_id": { "type": ["string", "null"] }, "wave": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 }, "generator": { "type": "string" } } },
        "recompute": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["verifier", "scores_sha256", "report_sha256"], "properties": { "verifier": { "type": "string" }, "scores_sha256": { "$ref": "#/$defs/Hex64" }, "report_sha256": { "$ref": "#/$defs/Hex64" } } }] },
        "text": { "type": "string" }
      }
    }
  }
}
