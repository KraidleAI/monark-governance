# systemd unit for the MONARK Narabi sentinel (ADR-M012 D5; addendum ADR-M005 D12). Orchestrator-deployed over
# the harness/vitrine SSH channel. A Type=oneshot job driven by monark-sentinel.timer (NOT a server): each run
# reads the `finalized` head, processes every complete UTC day in order, appends the timeline, and exits. FIRST
# outbound-network process on the VPS (public RPC, read-only); its ONE optional secret — the Chainstack
# endpoint URL (ADR-NARABI-OPS-1 L-3) — is read from an out-of-repo EnvironmentFile below, NEVER committed and
# NEVER echoed (only the guard transport reads it; run.ts publishes the NON-secret origin, C-1). DEDICATED `sentinel` user, its ONLY writable path is
# /var/lib/monark-sentinel (ProtectSystem=strict) — no harness write. 0 new dependency (R-8).
[Unit]
Description=MONARK Narabi sentinel - daily attested-flow tracker step (ADR-M012)
Documentation=https://github.com/KraidleAI/monark
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The deployed harness tree (apps/sentinel ships inside `apps/` via the harness git archive; RUNBOOK step 1).
# Read-only to this unit: ProtectSystem=strict + the single ReadWritePaths below.
WorkingDirectory=/opt/monark-harness
Environment=MONARK_SENTINEL_DIR=/var/lib/monark-sentinel
# Optional Chainstack endpoint (ADR-NARABI-OPS-1 L-3 / C-5): a DISTINCT paid operator that hardens the quorum
# against the free-pool outages behind the 2026-09-20 incident. Its URL (key in the path) lives ONLY in this
# root:sentinel 0640 file, NEVER committed (no_secret_in_repo scans for it). The leading `-` makes the file
# OPTIONAL: absent, the run falls back to the 7 public endpoints and stays fail-closed (ADR-M012 D5, amended by
# ADR-NARABI-OPS-1 — the base "no key" pool still publishes; the key only ADDS an 8th operator). Set/verify
# with `systemctl show -p EnvironmentFiles monark-sentinel.service` (RUNBOOK); the URL is never printed (C-1).
# NARABI-OPS-1d: the Chainstack leg is now METERED + LEDGERED through @monark/rpc-guard (decision 118 migration).
# Same root:sentinel 0640 EnvironmentFile carries, ALONGSIDE the (secret) endpoint URL, the NON-secret per-cycle
# keys the guarded leg needs (decision 121 option 1, floor/caps non-secret): CHAINSTACK_CYCLE_ID (same cycle as
# the Ukemi course), CHAINSTACK_ETH_ORIGIN (scheme+host only, published as provenance — the URL's origin, never
# its key path), and optional CHAINSTACK_CYCLE_FLOOR (dashboard RU floor, default 0). The cycle id OR the origin absent
# or empty => the run degrades to the 7 public endpoints (chainstack_guard:"unconfigured"), never a FATAL. The per-cycle
# ledger lives under the ReadWritePaths below at /var/lib/monark-sentinel/ledger (NOT under public/); its PARENT
# is pre-created by the RUNBOOK (`install -d -o sentinel -g sentinel -m 0750`, C-8 — never auto-created). The pool
# is 7 public + the guarded Chainstack leg = 8th. No new ReadWritePaths (the ledger is under it).
EnvironmentFile=-/etc/monark/sentinel.env
# MONARK_SENTINEL_J0 (drop-in) MUST be set to J0 BEFORE `systemctl enable` — the first run FAILS CLOSED
# without it (ADR-M012 D5); the unit never silently publishes nothing. Node 24 strips TypeScript at load.
ExecStart=/usr/bin/env node /opt/monark-harness/apps/sentinel/src/run.ts
# Start backstop (ADR-NARABI-OPS-1b-ii-b item 3, C-NB-5): T_s = max(300, ceil(3*D/60)*60) with D = the publishing
# run's wall clock = 25.481 s (RUN_DURATION_D_SEC=26 rounded up; JOURNAL-PROVENANCE.md:310, merge 9b178f3) => 300 s.
# 300 s >> D so a kill can only fire far past a normal run; and if it ever lands in the ~ms timeline append
# (run.ts:188), loadState recomputes from the timeline and fails CLOSED on a torn last line (never a served lie —
# copies :190/:191 happen AFTER). Coherent with the timer: 09:30 last slot + 1800 s jitter + 300 s = 10:05 UTC << the
# 10:30 UTC probe deadline (36300 s; probe_sentinel_timeoutstartsec_inter_unit_coherence). VPS SITE deploy = E-5 (decision 92).
TimeoutStartSec=300
# Least privilege (R-8 / M004 D0.3): a dedicated non-login user (RUNBOOK step 2), writing ONLY its state dir.
User=sentinel
Group=sentinel
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/monark-sentinel

# Resource caps (mirror monark-harness.service): a public RPC-reading batch job on the shared VPS must not
# starve the vitrine. CPUQuota=50% is at most half of ONE core (systemd semantics), not half the box.
CPUQuota=50%
MemoryMax=512M
TasksMax=128
