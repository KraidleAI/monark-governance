{
  "$comment": "MONARK vocabulary gate — ADR-M001 D8 / ADR-M002 D0 (09 discipline, Grok, adopted). Single source read by scripts/grep-forbidden.mjs and by any package test (atelier_no_forbidden_vocab). Regex source strings, flags 'i'. Adding a pattern = ADR line.",
  "banned": [
    { "re": "\\b95\\s*%\\s*(correct|accur|winning|gagnan)", "why": "\"95% correct/accurate/winning\" claim" },
    { "re": "\\b100\\s*%\\s*(correct|accur)", "why": "\"100% correct/accurate\" claim" },
    { "re": "\\b\\d{1,3}\\s*%\\s*(de\\s+|of\\s+)?[\\w-]*\\s*(corrects?|accurate|gagnants?|winning|wins?)\\b", "why": "\"X % of ... correct/winning\" claim (any X) — ADR-M002 D1 Lot D item (1)" },
    { "re": "anti[-\\s]?hallucination", "why": "\"anti-hallucination\" claim" },
    { "re": "hallucination[-\\s]?(free|proof)", "why": "\"hallucination-free/proof\" claim" },
    { "re": "\\beverlasting\\b", "why": "\"everlasting\" claim" },
    { "re": "guaranteed\\s+(correct|accura|coverage|no\\s+hallucination)", "why": "\"guaranteed correct/coverage\" claim" },
    { "re": "garantie[^\\n]{0,24}hallucination", "why": "French \"garantie ... hallucination\" claim" },
    { "re": "\\bfirst\\s+conformal\\s+prediction\\b", "why": "\"first conformal prediction\" claim (09)" },
    { "re": "\\b(true|vraie?)\\s+with\\s+probability\\b", "why": "\"true with probability\" claim (09)" }
  ],
  "scan": {
    "packages_src": { "extensions": [".ts"] },
    "atelier": { "package": "atelier", "extensions": [".ts", ".js", ".html", ".css", ".md"] }
  }
}
