{
  "name": "monark",
  "private": true,
  "version": "0.0.0",
  "description": "MONARK engine: HIKAE, a conformal gate that answers COMMIT, DEFER or ABSTAIN under controlled coverage (never a probability of being right), and Genkan, an order gate whose decisions come from a Lean kernel. Built to host a real trading strategy.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node -r ./test/helpers/blocking-stdout.cjs --test --test-timeout=300000 --test-force-exit \"--import=data:text/javascript,process.stdout._handle&&typeof(process.stdout._handle.setBlocking)==='function'&&process.stdout._handle.setBlocking(true);process.on('exit',function(c){if(c===0&&process.stdout.writableLength>0)process.exitCode=70})\" \"test/*.test.ts\" \"packages/*/test/*.test.ts\" \"apps/harness/test/!(*.kernel).test.ts\" \"apps/genkan/test/!(*.kernel).test.ts\"",
    "test:genkan": "node -r ./test/helpers/blocking-stdout.cjs --test --test-timeout=300000 --test-force-exit \"--import=data:text/javascript,process.stdout._handle&&typeof(process.stdout._handle.setBlocking)==='function'&&process.stdout._handle.setBlocking(true);process.on('exit',function(c){if(c===0&&process.stdout.writableLength>0)process.exitCode=70})\" \"apps/genkan/test/*.test.ts\" \"apps/harness/test/*.kernel.test.ts\"",
    "gate:vocab": "node scripts/grep-forbidden.mjs",
    "lint": "eslint .",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "ci": "npm run gate:vocab && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
