{
  "name": "monark",
  "private": true,
  "version": "0.0.0",
  "description": "MONARK — tokenisation layer + frozen interface contracts for the fleet (Shogen / HIKAE / UKEMI). Phase 0: skeleton & freeze. LOCAL-ONLY, no remote (ADR-M001 C14).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\" \"packages/*/test/*.test.ts\"",
    "gate:vocab": "node scripts/grep-forbidden.mjs",
    "lint": "eslint .",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "ci": "npm run gate:vocab && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
